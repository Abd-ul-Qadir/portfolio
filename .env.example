# Environment variables for the contact form (app/api/contact/route.ts).
#
# Copy this file to `.env.local` for local development, and set the same variables in the
# Vercel project's Environment Variables once it is deployed. `.env.local` is gitignored;
# this template is not, and must never hold a real key.

# ---------------------------------------------------------------------- required
# Resend API key. Create one at https://resend.com/api-keys (free tier: 3,000 emails/month).
# Without it the form does not send: the route logs a loud error, answers 503, and the UI
# falls back to showing the direct email address. It never silently drops a message.
RESEND_API_KEY=

# ---------------------------------------------------------------------- optional
# Where submissions are delivered. Defaults to `identity.email` in `content/data.ts`
# (abdulqadir12511@gmail.com), which is the address the site already publishes.
#
# NOTE: while the sender below is Resend's shared `onboarding@resend.dev`, Resend will only
# deliver to the email address that owns the Resend account. Keep them the same.
# CONTACT_TO_EMAIL=

# The From address. Defaults to "Portfolio <onboarding@resend.dev>", which needs no domain
# verification at all. Once a custom domain is verified in Resend, set this instead —
# e.g. "Portfolio <hello@yourdomain.com>" — and the recipient restriction above goes away.
# CONTACT_FROM_EMAIL=
